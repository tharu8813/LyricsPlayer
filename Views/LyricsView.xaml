<UserControl x:Class="LyricsPlayer.Views.LyricsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:LyricsPlayer.Views" Focusable="False">
  <Grid>
    <ListBox x:Name="Rows" ItemsSource="{Binding Lines}" SelectedIndex="{Binding ActiveIndex, Mode=OneWay}" SelectionChanged="ActiveChanged" PreviewMouseWheel="ManualWheel" PreviewMouseLeftButtonDown="RowMouseDown" PreviewKeyDown="RowKeyDown" RequestBringIntoView="PreventBring" SizeChanged="ViewResized" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" AutomationProperties.Name="동기화 가사: 위아래 화살표로 탐색">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="18,13"/><Setter Property="Margin" Value="8,2"/><Setter Property="MinHeight" Value="66"/><Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Frame" Padding="{TemplateBinding Padding}" CornerRadius="8" Background="Transparent">
            <ContentPresenter x:Name="Words" Opacity="0.42" RenderTransformOrigin="0.5,0.5"><ContentPresenter.RenderTransform><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></ContentPresenter.RenderTransform></ContentPresenter>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Accent}"/>
              <Trigger.EnterActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="Words" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.28"/>
                <DoubleAnimation Storyboard.TargetName="Words" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.32" EasingFunction="{StaticResource MotionEasing}"/>
                <DoubleAnimation Storyboard.TargetName="Words" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.32" EasingFunction="{StaticResource MotionEasing}"/>
              </Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="Words" Storyboard.TargetProperty="Opacity" To="0.42" Duration="0:0:0.32"/>
                <DoubleAnimation Storyboard.TargetName="Words" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.97" Duration="0:0:0.32"/>
                <DoubleAnimation Storyboard.TargetName="Words" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.97" Duration="0:0:0.32"/>
              </Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{StaticResource SurfaceHover}"/><Setter Property="Cursor" Value="Hand"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
      </Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" ToolTip="{Binding Timeline}"/></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <StackPanel VerticalAlignment="Center" Margin="24" IsHitTestVisible="False">
      <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Lines.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="{Binding LyricsMessage}" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource SecondaryText}" FontSize="17" LineHeight="30"/>
    </StackPanel>
  </Grid>
</UserControl>
