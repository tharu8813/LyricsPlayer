<UserControl x:Class="LyricsPlayer.Views.PlaybackControlBar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:LyricsPlayer.Views">
  <Grid Margin="24,10,24,16">
    <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="50"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding CurrentTime}" FontFamily="Consolas" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" MinWidth="52"/>
    <Slider x:Name="PositionSlider" Grid.Column="1" Minimum="0" Maximum="{Binding Length}" Value="{Binding Position, Mode=OneWay}" ValueChanged="PositionChanged" PreviewMouseLeftButtonDown="SeekStarted" PreviewMouseLeftButtonUp="SeekEnded" LostMouseCapture="SeekCaptureLost" PreviewKeyUp="SeekKeyUp" PreviewMouseWheel="SeekWheel" IsEnabled="{Binding HasMedia}" AutomationProperties.Name="재생 위치"/>
    <TextBlock Grid.Column="2" Text="{Binding TotalTime}" FontFamily="Consolas" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" MinWidth="52" TextAlignment="Right"/>
    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
      <Button Style="{StaticResource IconButton}" Command="{Binding PreviousCommand}" ToolTip="이전 곡 (Ctrl+Left)" AutomationProperties.Name="이전 곡"><Path Data="{StaticResource PreviousIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="17" Height="17" Stretch="Uniform"/></Button>
      <Button Command="{Binding PlayPauseCommand}" ToolTip="{Binding PlayPauseLabel}" AutomationProperties.Name="{Binding PlayPauseLabel}" Width="48" Height="46" Margin="5,0" Background="{StaticResource Accent}" Foreground="{StaticResource Background}">
        <Path Width="19" Height="19" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"><Path.Style><Style TargetType="Path"><Setter Property="Data" Value="{StaticResource PlayIcon}"/><Style.Triggers><DataTrigger Binding="{Binding IsPlaying}" Value="True"><Setter Property="Data" Value="{StaticResource PauseIcon}"/></DataTrigger></Style.Triggers></Style></Path.Style></Path>
      </Button>
      <Button Style="{StaticResource IconButton}" Command="{Binding NextCommand}" ToolTip="다음 곡 (Ctrl+Right)" AutomationProperties.Name="다음 곡"><Path Data="{StaticResource NextIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="17" Height="17" Stretch="Uniform"/></Button>
      <Button Style="{StaticResource IconButton}" Command="{Binding StopCommand}" ToolTip="정지" AutomationProperties.Name="정지"><Path Data="{StaticResource StopIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform"/></Button>
    </StackPanel>
    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="22,0" FontWeight="SemiBold"/>
    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
      <ComboBox ItemsSource="{Binding Rates}" SelectedItem="{Binding Rate}" Width="78" Margin="0,0,16,0" ToolTip="재생속도" AutomationProperties.Name="재생속도"><ComboBox.ItemStringFormat>{0:0.##}x</ComboBox.ItemStringFormat></ComboBox>
      <Path Data="{StaticResource VolumeIcon}" Stroke="{StaticResource SecondaryText}" StrokeThickness="1.5" Width="20" Height="20" Stretch="Uniform"/>
      <Slider Minimum="0" Maximum="100" Value="{Binding Volume, UpdateSourceTrigger=PropertyChanged}" Width="100" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True" Margin="6,0,12,0" ToolTip="볼륨" AutomationProperties.Name="볼륨"/>
      <Button Style="{StaticResource IconButton}" Click="FullscreenClicked" ToolTip="전체화면 (F11 / ESC)" AutomationProperties.Name="전체화면 전환"><Path Data="{StaticResource FullscreenIcon}" Stroke="{StaticResource PrimaryText}" StrokeThickness="1.5" Width="18" Height="18" Stretch="Uniform"/></Button>
    </StackPanel>
  </Grid>
</UserControl>
