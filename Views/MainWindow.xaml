<Window x:Class="LyricsPlayer.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:LyricsPlayer.Views" xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF" Style="{StaticResource {x:Type Window}}" Title="LyricsPlayer" Width="1360" Height="860" MinWidth="1000" MinHeight="620" WindowStartupLocation="CenterScreen" Icon="/LyricsPlayer;component/Assets/icon.ico" AllowDrop="True" DragOver="FilesDragOver" Drop="FilesDropped" PreviewKeyDown="WindowKeyDown" PreviewMouseMove="UserActivity" PreviewMouseDown="UserActivity" SourceInitialized="SourceReady" SizeChanged="WindowResized">
  <Grid x:Name="Root">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="Header" Margin="28,22,28,20">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal"><Image Source="/LyricsPlayer;component/Assets/icon.ico" Width="30" Height="30" Margin="0,0,12,0"/><TextBlock Text="LyricsPlayer" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
      <TextBlock Grid.Column="1" Text="A LITTLE CLOSER TO THE MUSIC" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="24,0"/>
      <StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="재생목록" Click="ToggleLibrary" Margin="0,0,8,0" AutomationProperties.Name="재생목록 표시 전환"/><Button Click="OpenFile" ToolTip="미디어 열기 (Ctrl+O)" BorderBrush="{StaticResource Border}"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource FolderIcon}" Stroke="{StaticResource Accent}" StrokeThickness="1.5" Width="17" Height="17" Stretch="Uniform" Margin="0,0,9,0"/><TextBlock Text="파일 열기"/></StackPanel></Button></StackPanel>
    </Grid>
    <Grid Grid.Row="1" x:Name="ContentGrid" Margin="28,0,28,0">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="MediaColumn" Width="1.08*" MinWidth="220"/><ColumnDefinition Width="16"/><ColumnDefinition x:Name="LyricsColumn" Width="1*" MinWidth="240"/><ColumnDefinition x:Name="LibraryGap" Width="24"/><ColumnDefinition x:Name="LibraryColumn" Width="270"/></Grid.ColumnDefinitions>
      <Border x:Name="MediaPanel" Background="{StaticResource Surface}" CornerRadius="12" Padding="18">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Margin="2,0,2,18"><TextBlock Text="01 / SCREEN" Style="{StaticResource Caption}"/><TextBlock DockPanel.Dock="Right" Text="{Binding PlaybackState}" Foreground="{StaticResource Accent}" FontSize="11" HorizontalAlignment="Right"/></DockPanel>
          <Grid Grid.Row="1">
            <vlc:VideoView x:Name="Video" MediaPlayer="{Binding Player}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
              <!-- VideoView content uses the library's supported airspace overlay window. -->
              <Grid Background="#01000000" MouseLeftButtonDown="VideoMouseDown" MouseMove="UserActivity" PreviewKeyDown="WindowKeyDown" AllowDrop="True" DragOver="FilesDragOver" Drop="FilesDropped">
                <Border x:Name="VideoEmpty" Background="#151C18">
                  <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasVideo}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                  <StackPanel VerticalAlignment="Center" Margin="20">
                    <Grid Width="132" Height="132" Margin="0,0,0,28"><Ellipse Stroke="#34483B" StrokeThickness="1"/><Ellipse Stroke="#34483B" StrokeThickness="1" Margin="15"/><Ellipse Stroke="#34483B" StrokeThickness="1" Margin="30"/><Ellipse Fill="{StaticResource Accent}" Width="16" Height="16"/></Grid>
                    <TextBlock Text="당신의 음악을,&#10;조금 더 가까이." TextAlignment="Center" FontSize="26" FontWeight="Light" LineHeight="38"/>
                    <TextBlock Text="MP4 · MP3 · WMV · MKV" Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,18,0,0"/>
                  </StackPanel>
                </Border>
                <TextBlock x:Name="FullscreenHint" Text="ESC로 돌아가기" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20" Background="#C0111514" Padding="12,8" Visibility="Collapsed"/>
              </Grid>
            </vlc:VideoView>
          </Grid>
          <StackPanel Grid.Row="2" Margin="2,22,2,2"><TextBlock Text="지금 듣는 곡" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Title}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="90" Margin="0,8,0,0"/></StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="10,4,4,12"><Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="OpenPip" ToolTip="가사 PiP (Ctrl+P)" AutomationProperties.Name="가사 PiP 열기"><Path Data="{StaticResource PipIcon}" Stroke="{StaticResource SecondaryText}" StrokeThickness="1.5" Width="19" Height="19" Stretch="Uniform"/></Button><StackPanel><TextBlock Text="02 / LYRICS" Style="{StaticResource Caption}"/><CheckBox Content="음악에 맞춰 가사 확대" IsChecked="{Binding MusicReactionEnabled}" Foreground="{StaticResource SecondaryText}" Margin="0,9,0,0" ToolTip="끄면 음악 반응 분석도 수행하지 않습니다."/></StackPanel></DockPanel>
        <local:LyricsView x:Name="MainLyrics" Grid.Row="1"/>
        <DockPanel Grid.Row="2" Margin="12,12,8,10"><TextBlock Text="시간 보정" Style="{StaticResource Caption}" VerticalAlignment="Center"/><TextBox Text="{Binding SyncOffsetMs, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" Width="70" Margin="12,0,5,0" AutomationProperties.Name="가사 시간 보정 밀리초"/><TextBlock Text="ms" Style="{StaticResource Caption}" VerticalAlignment="Center"/><Button Content="초기화" Command="{x:Null}" Click="ResetOffset" ToolTip="기본 보정 200ms" Padding="8,4" HorizontalAlignment="Right"/></DockPanel>
      </Grid>
      <Grid x:Name="LibraryPanel" Grid.Column="4">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="03 / LIBRARY" Style="{StaticResource Caption}"/><TextBlock Text="재생목록" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel>
          <Button Grid.Column="1" Style="{StaticResource IconButton}" Command="{Binding OpenFolderCommand}" ToolTip="Videos\LyricsPlayer 폴더 열기" AutomationProperties.Name="라이브러리 폴더 열기"><Path Data="{StaticResource FolderIcon}" Stroke="{StaticResource SecondaryText}" StrokeThickness="1.5" Width="18" Height="18" Stretch="Uniform"/></Button>
          <Button Grid.Column="2" Style="{StaticResource IconButton}" Command="{Binding RefreshCommand}" ToolTip="재생목록 갱신" AutomationProperties.Name="재생목록 갱신"><Path Data="{StaticResource RefreshIcon}" Stroke="{StaticResource SecondaryText}" StrokeThickness="1.5" Width="18" Height="18" Stretch="Uniform"/></Button>
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,14"><TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="34,10,10,10" AutomationProperties.Name="재생목록 검색"/><Path Data="{StaticResource SearchIcon}" Stroke="{StaticResource SecondaryText}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Left" Margin="11,0" IsHitTestVisible="False"/><TextBlock Text="곡 검색" Margin="35,0,0,0" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
        <Grid Grid.Row="2">
          <ListBox x:Name="LibraryList" ItemsSource="{Binding FilteredItems}" MouseDoubleClick="PlaySelected" PreviewKeyDown="PlaylistKeyDown" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="재생목록">
            <ListBox.ContextMenu><ContextMenu><MenuItem Header="파일 위치 열기" Click="RevealSelected"/><MenuItem Header="목록 갱신" Click="RefreshLibrary"/><Separator/><MenuItem Header="폴더에서 파일을 이동하면 목록도 갱신됩니다" IsEnabled="False"/></ContextMenu></ListBox.ContextMenu>
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,2"/><Setter Property="Padding" Value="12,13"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="Frame" Background="Transparent" CornerRadius="7" BorderBrush="Transparent" BorderThickness="1"><Grid>
                <Border x:Name="Hover" Background="{StaticResource SurfaceHover}" CornerRadius="6" Opacity="0"/>
                <Border x:Name="Playing" Background="#203F503C" CornerRadius="6" Opacity="0"/>
                <Border x:Name="AccentLine" Width="2" Background="{StaticResource Accent}" HorizontalAlignment="Left" Margin="0,11" Opacity="0"/>
                <ContentPresenter Margin="{TemplateBinding Padding}"/>
              </Grid></Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Border}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True"><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter TargetName="AccentLine" Property="Opacity" Value="1"/><DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Playing" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions><DataTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Playing" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/></Storyboard></BeginStoryboard></DataTrigger.ExitActions></DataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" FontWeight="SemiBold" ToolTip="{Binding Path}"/><TextBlock Text="{Binding Format}" Style="{StaticResource Caption}" FontSize="10" Margin="0,6,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Duration}" Style="{StaticResource Caption}" FontFamily="Consolas" VerticalAlignment="Center" Margin="10,0,0,0"/></Grid></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="아직 곡이 없습니다.&#10;&#10;Videos\LyricsPlayer에 미디어를 넣거나&#10;파일을 이 창으로 끌어 놓으세요." TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="16" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding LibraryCount}" Value="0 / 0 곡"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        </Grid>
        <DockPanel Grid.Row="3" Margin="4,14,4,10"><TextBlock Text="{Binding LibraryCount}" Style="{StaticResource Caption}"/><TextBlock Text="폴더 자동 동기화" Style="{StaticResource Caption}" HorizontalAlignment="Right"/></DockPanel>
      </Grid>
    </Grid>
    <Grid x:Name="StatusPanel" Grid.Row="2" Margin="30,14,30,4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ProgressBar IsIndeterminate="True" Width="42" Height="3" Foreground="{StaticResource Accent}" Background="{StaticResource Border}" Margin="0,0,12,0" Visibility="{Binding IsLoading, Converter={StaticResource BoolVisibility}}"/><TextBlock Grid.Column="1" Text="{Binding Status}" Style="{StaticResource Caption}" TextWrapping="Wrap"/></Grid>
    <Border Grid.Row="3" x:Name="ControlsFrame" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Background="{StaticResource Background}"><Border.RenderTransform><TranslateTransform/></Border.RenderTransform><local:PlaybackControlBar x:Name="Controls" FullscreenRequested="ToggleFullscreen"/></Border>
  </Grid>
</Window>
